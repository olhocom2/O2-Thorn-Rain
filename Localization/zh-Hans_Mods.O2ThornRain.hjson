Items: {
	DragonPower: {
		DisplayName: 荆棘短匕
		Tooltip:
			'''
			蕴含狂暴荆棘之力的远古短匕
			召唤强大的风暴巨龙坐骑
			骑乘时获得自由飞行能力并免疫荆棘之雨的尖刺
			'''
	}

	DragonMountItem: {
		DisplayName: 苍穹龙怒
		Tooltip:
			'''
			征服荆棘风暴之眼后获得的远古圣物
			召唤传奇荆棘巨龙作为坐骑
			提供无限飞行、极高机动性并免疫风暴尖刺伤害
			'''
	}

	LightningRod: {
		DisplayName: 风暴避雷针
		Tooltip:
			'''
			引导四大远古之风的愤怒
			召唤“四相风暴”事件
			若事件已处于激活状态则无法使用
			'''
	}

	ThornStormBossBag: {
		DisplayName: 宝藏袋（荆棘风暴之眼）
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	ThornStormBossTrophy: {
		DisplayName: 荆棘风暴之眼纪念章
		Tooltip: ""
	}
}

