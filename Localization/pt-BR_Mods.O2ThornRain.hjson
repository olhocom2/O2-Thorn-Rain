Projectiles: {
	SpikesProjectile.DisplayName: Espinho Pontiagudo
	ThornTornadoProjectile.DisplayName: Tornado de Espinhos
	ThornDragonProjectile.DisplayName: Dragão de Espinhos
}

Items: {
	DragonPower: {
		DisplayName: Adaga de Espinhos
		Tooltip:
			'''
			Uma adaga ancestral imbuída com o poder tempestuoso dos espinhos
			Invoca uma poderosa montaria de dragão da tempestade
			Concede voo livre e imunidade aos espinhos da Thorn Rain enquanto montado
			'''
	}

	DragonMountItem: {
		DisplayName: Fúria do Dragão Celestial
		Tooltip:
			'''
			Uma relíquia ancestral obtida ao subjugar o Olho da Tempestade
			Invoca o lendário Dragão do Cultista como montaria
			Concede voo infinito, agilidade extrema e imunidade aos espinhos da tempestade
			'''
	}

	LightningRod: {
		DisplayName: Para-raios da Tempestade
		Tooltip:
			'''
			Atrai a fúria dos quatro ventos ancestrais
			Invoca o evento "A Tempestade dos Quatro"
			Não pode ser usado se o evento já estiver em andamento
			'''
	}
}

Buffs: {
	DragonMountBuff: {
		DisplayName: Dragão do Cultista
		Description: Você cavalga o dragão celestial da tempestade. Imune aos espinhos da Thorn Rain!
	}
}

Mounts.DragonMount.DisplayName: Dragão do Cultista

NPCs: {
	ThornStormSummonTornado.DisplayName: Pequeno Vórtice Abissal
	ThornBiomeTornado.DisplayName: Tornado de Espinhos Ancestral
	ThornStormBoss.DisplayName: O Olho da Tempestade de Espinhos
}

