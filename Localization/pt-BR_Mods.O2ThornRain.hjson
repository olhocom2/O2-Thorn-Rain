Projectiles: {
	SpikesProjectile.DisplayName: Espinho Pontiagudo
	ThornTornadoProjectile.DisplayName: Tornado de Espinhos
	ThornDragonProjectile.DisplayName: Dragão de Espinhos
}

Items: {
	DragonPower: {
		DisplayName: Adaga de Espinhos
		Tooltip:
			'''
			Uma adaga ancestral imbuída com o poder tempestuoso dos espinhos
			Invoca uma poderosa montaria de dragão da tempestade
			Concede voo livre e imunidade aos espinhos da Thorn Rain enquanto montado
			'''
	}

	DragonMountItem: {
		DisplayName: Fúria do Dragão Celestial
		Tooltip:
			'''
			Uma relíquia ancestral obtida ao subjugar o Olho da Tempestade
			Invoca o lendário Dragão Espinhento como montaria
			Concede voo infinito, agilidade extrema e imunidade aos espinhos da tempestade
			'''
	}

	LightningRod: {
		DisplayName: Para-raios da Tempestade
		Tooltip:
			'''
			Atrai a fúria dos quatro ventos ancestrais
			Invoca o evento "A Tempestade dos Quatro"
			Não pode ser usado se o evento já estiver em andamento
			'''
	}

	ThornStormBossBag: {
		DisplayName: Bolsa de Tesouro (Olho da Tempestade)
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	ThornStormBossTrophy: {
		DisplayName: Troféu do Olho da Tempestade
		Tooltip: ""
	}
}

Buffs: {
	DragonMountBuff: {
		DisplayName: Dragão Espinhento
		Description: Você cavalga o dragão espinhento da tempestade. Imune aos espinhos da Thorn Rain!
	}
}

Mounts.DragonMount.DisplayName: Dragão Espinhento

NPCs: {
	ThornStormSummonTornado.DisplayName: Pequeno Vórtice Abissal
	ThornBiomeTornado.DisplayName: Tornado de Espinhos Ancestral
	ThornStormBoss.DisplayName: O Olho da Tempestade de Espinhos
	ThornMinionTornado.DisplayName: Mini Vórtice Voraz
}

Tiles.ThornStormBossTrophyTile.MapEntry: Troféu

Biomes: {
	Jungle: Selva
	Snow: Neve
	Desert: Deserto
	Corruption: Corrupção
}

Events: {
	TornadoWarning: Uma ameaça de tornado foi avistada aos arredores...
	TornadoIncoming: Um tornado de espinhos se aproxima!
	RainIntensifying: A chuva de espinhos está ficando mais intensa...
	StormApproaching: Uma tempestade de espinhos se aproxima!
	MiniTornadoSpawned: Um vórtice misterioso surgiu nas profundezas do oceano...
	StormOfFourStarted: A Tempestade dos Quatro despertou! Quatro tornados ancestrais surgiram pelo mundo!
	TornadoDefeated: O Tornado de Espinhos da {0} foi silenciado! ({1}/4)
	AllFourDefeated: Os quatro ventos foram silenciados...
	FinalStormIncoming: Algo gigantesco se aproxima da tempestade...
	FinalStormVictory: A tempestade final se dissipou... A calmaria retorna ao mundo.
	EventExpired: Os ventos turbulentos se dissiparam e o clima voltou a ficar calmo...
}
