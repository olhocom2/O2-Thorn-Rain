	DragonPower: {
		DisplayName: Spike Dagger
		Tooltip:
			'''
			An ancestral dagger imbued with tempestuous thorn power
			Summons a powerful storm dragon mount
			Grants free flight and immunity to Thorn Rain spikes while mounted
			'''
	}

	DragonMountItem: {
		DisplayName: Wrath of the Celestial Dragon
		Tooltip:
			'''
			An ancient relic obtained by subduing the Eye of the Thorn Storm
			Summons the legendary Cultist Dragon as a mount
			Grants infinite flight, extreme agility, and immunity to storm spikes
			'''
	}

	LightningRod: {
		DisplayName: Storm Lightning Rod
		Tooltip:
			'''
			Channels the wrath of the four ancestral winds
			Summons "The Storm of Four" event
			Cannot be used if the event is already active
			'''
	}

