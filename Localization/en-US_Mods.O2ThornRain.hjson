		DisplayName: Treasure Bag (Eye of the Thorn Storm)
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	ThornStormBossTrophy: {
		DisplayName: Eye of the Thorn Storm Trophy
		Tooltip: ""
	}
}

